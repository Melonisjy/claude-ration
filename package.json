{
  "name": "claude-ration",
  "version": "0.1.10",
  "description": "Automatically stops Claude Code when it hits your custom usage threshold",
  "type": "module",
  "bin": {
    "claude-ration": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "usage",
    "limit",
    "rate-limit",
    "plugin",
    "hook",
    "statusline"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Melonisjy/claude-ration",
  "repository": {
    "type": "git",
    "url": "https://github.com/Melonisjy/claude-ration.git"
  },
  "bugs": {
    "url": "https://github.com/Melonisjy/claude-ration/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
